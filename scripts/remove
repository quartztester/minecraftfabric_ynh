#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================

ynh_script_progression "Stopping the Minecraft server..."
systemctl stop "$app" 2>/dev/null || true

#=================================================
# REMOVE SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Removing nginx, systemd unit and BlueMap fragment..."
ynh_config_remove_nginx
yunohost service remove "$app" || true
ynh_config_remove_systemd
systemctl daemon-reload
ynh_safe_rm "/usr/share/yunohost/applogos/$app.png"

bluemap_domain=$(ynh_app_setting_get --key=bluemap_domain 2>/dev/null || echo "")
if [ -n "${bluemap_domain:-}" ]; then
    ynh_safe_rm "/etc/nginx/conf.d/$bluemap_domain.d/$app.conf"
    ynh_delete_file_checksum "/etc/nginx/conf.d/$bluemap_domain.d/$app.conf" 2>/dev/null || true
    ynh_systemctl --service=nginx --action=reload
    # NB: the bluemap domain object itself belongs to the admin, not the app —
    # it is intentionally left in place.
fi

#=================================================
# REMOVE SERVER DATA
#=================================================

ynh_script_progression "Removing server data (world saves, mods, BlueMap tiles)..."
ynh_safe_rm "$data_dir"

#=================================================
# REMOVE RUNTIME (JRE, FABRIC INSTALLER)
#=================================================

ynh_script_progression "Removing runtime (JRE, Fabric installer)..."
ynh_safe_rm "$install_dir"

# (game/voice ports are closed by the ports resource deprovision)

#=================================================
# END OF SCRIPT
#=================================================
